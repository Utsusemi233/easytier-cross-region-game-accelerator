#!/bin/sh /etc/rc.common
START=97
STOP=8
USE_PROCD=1
start_service() {
 . /etc/easytier-direct/fec.env
 key=$(cat "$KEY_FILE") || return 1
 case "$key" in ''|*[!a-zA-Z0-9]*) return 1;; esac
 test -x "$SPEEDER_EXE" || return 1
 addresses=$(/usr/libexec/easytier-direct/direct-fec-addresses.sh 2>/dev/null)
 printf '%s\n' "$addresses" >/var/run/easytier-direct-fec-addresses
 index=0
 for address in $addresses; do
  index=$((index+1))
  procd_open_instance "v6_$index"
  procd_set_param command "$SPEEDER_EXE" -s -l "[$address]:$PUBLIC_PORT" -r "127.0.0.1:$NATIVE_PORT" -k "$key" "-f$FEC" --timeout "$TIMEOUT_MS" --mode "$MODE" --sock-buf 1024 --log-level 2 --disable-color
  procd_set_param env "LD_LIBRARY_PATH=$SPEEDER_LIBRARY_PATH"
  procd_set_param respawn 3600 5 0
  procd_close_instance
 done
 procd_open_instance authorized_private
 procd_set_param command "$SPEEDER_EXE" -s -l "$PRIVATE_IPV4:$PRIVATE_PORT" -r "127.0.0.1:$NATIVE_PORT" -k "$key" "-f$FEC" --timeout "$TIMEOUT_MS" --mode "$MODE" --sock-buf 1024 --log-level 2 --disable-color
 procd_set_param env "LD_LIBRARY_PATH=$SPEEDER_LIBRARY_PATH"
 procd_set_param respawn 3600 5 0
 procd_close_instance
}
