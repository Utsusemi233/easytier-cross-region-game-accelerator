WAN_INTERFACE=wan
SPEEDER_EXE=/usr/libexec/easytier-direct/udpspeeder
SPEEDER_LIBRARY_PATH=/usr/libexec/easytier-direct/lib
KEY_FILE=/etc/easytier-direct/fec-key
PRIVATE_IPV4=192.0.2.10
PUBLIC_PORT=11022
PRIVATE_PORT=11023
NATIVE_PORT=11020
FEC=2:4
TIMEOUT_MS=1
MODE=0
# Addresses and 2:4 are format examples, not an accepted deployment or tuning recommendation.
