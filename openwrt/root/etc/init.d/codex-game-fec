#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 [ "$(jsonfilter -i /etc/codex-game/endpoint-config.json -e '@.role')" = client ] || return 0
 source="$(lua /usr/libexec/codex-game/endpoint-common.lua address)"
 remote="$(lua /usr/libexec/codex-game/endpoint-common.lua stored-home)"
 [ -n "$source" ] && [ -n "$remote" ] || return 0
 eval "$(lua - <<'LUA'
local M=dofile('/usr/libexec/codex-game/endpoint-common.lua'); local c=M.config()
for _,item in ipairs({{'fec',tostring(c.fec_data)..':'..tostring(c.fec_redundant)},{'port',c.fec_port},{'local_port',c.local_port},{'timeout',c.fec_timeout},{'interval',c.fec_interval}}) do
 assert(tostring(item[2]):match('^[%d:]+$')); print(item[1]..'='..M.quote(item[2]))
end
LUA
)"
 ip route replace default dev wg_game table 2850
 wg_source="$(jsonfilter -i /etc/codex-game/endpoint-config.json -e '@.wg_source')"
 ip rule del priority 11020 2>/dev/null || true
 ip rule add priority 11020 from "$wg_source/32" lookup 2850
 scope="$(jsonfilter -i /etc/codex-game/endpoint-config.json -e '@.game_cidr')"
 ip rule del priority 11030 2>/dev/null || true
 ip rule add priority 11030 from "$scope" fwmark 0x80000000/0x80000000 lookup 2848
 procd_open_instance
 procd_set_param command /usr/libexec/codex-game/udpspeeder -c -l "127.0.0.1:$local_port" -r "[$remote]:$port" --out-addr "[$source]:0" -f "$fec" --timeout "$timeout" -i "$interval" --report 60 --log-level 3
 procd_set_param env LD_LIBRARY_PATH=/usr/libexec/codex-game/lib
 procd_set_param respawn 3600 5 0
 procd_close_instance
}
