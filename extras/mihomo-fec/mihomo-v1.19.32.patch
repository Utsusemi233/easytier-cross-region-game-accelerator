+func (e *EasyTier) peerEndpointSignature() (string, error) {
+	ctx, cancel := context.WithTimeout(e.ctx, 3*time.Second)
+	defer cancel()
+	values := []string{}
+	for _, peer := range e.option.Peers {
+		u, err := url.Parse(peer)
+		if err != nil {
+			return "", err
+		}
+		host := u.Hostname()
+		if host == "" {
+			continue
+		}
+		if ip, err := netip.ParseAddr(host); err == nil {
+			values = append(values, u.Scheme+"/"+ip.String()+"/"+u.Port())
+			continue
+		}
+		var ips []netip.Addr
+		if fresh, ok := resolver.ProxyServerHostResolver.(interface {
+			LookupFreshIP(context.Context, string, bool) ([]netip.Addr, error)
+		}); ok {
+			ips, err = fresh.LookupFreshIP(ctx, host, e.option.IPVersion == C.IPv6Only || e.option.IPVersion == C.IPv6Prefer)
+		} else if fresh, ok := resolver.SystemResolver.(interface {
+			LookupFreshIP(context.Context, string, bool) ([]netip.Addr, error)
+		}); ok {
+			ips, err = fresh.LookupFreshIP(ctx, host, e.option.IPVersion == C.IPv6Only || e.option.IPVersion == C.IPv6Prefer)
+		} else {
+			version := uint8(4)
+			if e.option.IPVersion == C.IPv6Only || e.option.IPVersion == C.IPv6Prefer {
+				version = 6
+			}
+			ips, err = (easytier.DNSResolver{}).LookupIP(ctx, platform.DNSQuery{Host: host, IPVersion: version})
+		}
+		if err != nil {
+			return "", err
+		}
+		for _, ip := range ips {
+			values = append(values, u.Scheme+"/"+ip.String()+"/"+u.Port())
+		}
+	}
+	sort.Strings(values)
+	return strings.Join(values, ","), nil
+}
