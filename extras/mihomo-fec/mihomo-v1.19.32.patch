+// LookupFreshIP refreshes only the requested peer domain. It does not clear
+// application DNS caches or modify the resolver's routing policy.
+func (r *Resolver) LookupFreshIP(ctx context.Context, host string, ipv6 bool) ([]netip.Addr, error) {
+	qtype := uint16(D.TypeA)
+	if ipv6 {
+		qtype = D.TypeAAAA
+	}
+	m := &D.Msg{}
+	m.SetQuestion(D.Fqdn(host), qtype)
+	answer, err := r.exchangeWithoutCache(ctx, m)
+	if err != nil {
+		return nil, err
+	}
+	out := []netip.Addr{}
+	for _, rr := range answer.Answer {
+		switch v := rr.(type) {
+		case *D.A:
+			if ip, ok := netip.AddrFromSlice(v.A); ok {
+				out = append(out, ip.Unmap())
+			}
+		case *D.AAAA:
+			if ip, ok := netip.AddrFromSlice(v.AAAA); ok {
+				out = append(out, ip)
+			}
+		}
+	}
+	if len(out) == 0 {
+		return nil, fmt.Errorf("peer domain returned no addresses")
+	}
+	return out, nil
+}
