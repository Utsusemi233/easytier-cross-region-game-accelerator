#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1

start_service() {
    [ -s /etc/codex-relay-ddns/config.private.json ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/lua /usr/libexec/codex-relay-ddns/relay-ddns.lua --loop
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/codex-relay-ddns/config.private.json
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger codex-relay-ddns
}
